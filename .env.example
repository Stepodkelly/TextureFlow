# TextureFlow / Moth Market local config
#
# Convex and VoiceOS are STUBBED by default. Leave these blank unless you
# intentionally restore live cloud sync later.

# Optional (stubbed / unused by default)
CONVEX_API_KEY=
CONVEX_DEPLOY_KEY=
CONVEX_URL=
CONVEX_DEPLOYMENT=

# Optional intelligence provider (has deterministic fallback without a key)
OPENAI_API_KEY=

# Voice bridge defaults to the fixture adapter (no Convex / no VoiceOS host required).
TEXTUREFLOW_ADAPTER=fixture
TEXTUREFLOW_OWNER_ID=local-owner
TEXTUREFLOW_BRIDGE_TOKEN=
TEXTUREFLOW_DEVICE_TOKEN=
TEXTUREFLOW_USER_TOKEN=

# Streamable HTTP bridge listener (fixture mode).
TEXTUREFLOW_HTTP_HOST=127.0.0.1
TEXTUREFLOW_HTTP_PORT=8787
