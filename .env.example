# Convex credential supplied outside version control.
CONVEX_API_KEY=
CONVEX_DEPLOY_KEY=

# Filled after the Convex deployment is configured.
CONVEX_URL=
CONVEX_DEPLOYMENT=

# Optional intelligence provider configuration.
OPENAI_API_KEY=

# Voice bridge and scoped demo-role configuration.
TEXTUREFLOW_ADAPTER=fixture
TEXTUREFLOW_OWNER_ID=demo-owner
TEXTUREFLOW_BRIDGE_TOKEN=
TEXTUREFLOW_DEVICE_TOKEN=
TEXTUREFLOW_USER_TOKEN=

# Streamable HTTP bridge listener.
TEXTUREFLOW_HTTP_HOST=127.0.0.1
TEXTUREFLOW_HTTP_PORT=8787
